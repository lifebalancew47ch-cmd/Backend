{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {CorrelationId} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/dashboard-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff} {Level:u3}] [{CorrelationId}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithEnvironmentName", "WithThreadId", "WithMachineName" ]
  },

  "AllowedHosts": "*",

  "MongoDb": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "lifebalance_dashboard"
  },

  "ConnectionStrings": {
    "MongoDB": "mongodb://localhost:27017"
  },

  "Jwt": {
    "Issuer": "LifeBalance",
    "Audience": "LifeBalance",
    "SecretKey": "CHANGE_THIS_TO_A_32_CHARACTER_SECRET_KEY_IN_PRODUCTION!!",
    "ExpiryMinutes": 60
  },

  "ServiceUrls": {
    "AuthServiceUrl": "https://lifebalance-auth-service.onrender.com",
    "MedicalDataServiceUrl": "https://medical-service-hb0v.onrender.com",
    "SedentaryEngineServiceUrl": "https://sedentary-engine-service.onrender.com",
    "GamificationServiceUrl": "https://gamification-service-9o3z.onrender.com",
    "NotificationServiceUrl": "https://lifebalance-notifications-api.onrender.com",
    "MlPredictionServiceUrl": "https://ml-prediction-service-0sqa.onrender.com",
    "OrganizationServiceUrl": "https://lifebalance-organization-saas.onrender.com",
    "ReportingServiceUrl": "https://lifebalance-reporting-service.onrender.com"
  },

  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173",
      "https://lifebalance-adv3.onrender.com"
    ]
  },
  "CORS": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173",
      "https://lifebalance-adv3.onrender.com"
    ]
  },

  "HealthChecks": {
    "Enabled": true
  },

  "OpenTelemetry": {
    "ServiceName": "dashboard-service",
    "Endpoint": "http://localhost:4317"
  }
}
