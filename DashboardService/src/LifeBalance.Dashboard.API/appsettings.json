{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {CorrelationId} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/dashboard-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff} {Level:u3}] [{CorrelationId}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithEnvironmentName", "WithThreadId", "WithMachineName" ]
  },

  "AllowedHosts": "*",

  "MongoDb": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "lifebalance_dashboard"
  },

  "ConnectionStrings": {
    "MongoDB": "mongodb://localhost:27017"
  },

  "Jwt": {
    "Issuer": "LifeBalance.AuthService",
    "Audience": "LifeBalance.Services",
    "SecretKey": "REPLACE_WITH_SECURE_SECRET_KEY_MINIMUM_32_CHARACTERS",
    "ExpiryMinutes": 60
  },

  "HttpClients": {
    "HabitsServiceBaseUrl": "https://habits-service.lifebalance.io",
    "NutritionServiceBaseUrl": "https://nutrition-service.lifebalance.io",
    "FitnessServiceBaseUrl": "https://fitness-service.lifebalance.io",
    "SleepServiceBaseUrl": "https://sleep-service.lifebalance.io",
    "TimeoutSeconds": 30,
    "RetryCount": 3
  },

  "CORS": {
    "AllowedOrigins": [
      "https://app.lifebalance.io"
    ]
  },

  "HealthChecks": {
    "Enabled": true
  },

  "OpenTelemetry": {
    "ServiceName": "dashboard-service",
    "Endpoint": "http://localhost:4317"
  }
}
